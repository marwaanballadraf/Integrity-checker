#!/usr/bin/env python3
import argparse
import sys

from baseline import init, BaselineError
from checker import check
from updater import update


def main():
    parser = argparse.ArgumentParser(
        prog="integrity-check",
        description="Detect tampering in log files using SHA-256 hashes.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    commands = [
        ("init", "Hash files and store them as the trusted baseline"),
        ("check", "Compare files against the baseline"),
        ("update", "Accept the current state of files as the new baseline"),
    ]
    for name, help_text in commands:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("target", help="A log file or a directory of logs")

    args = parser.parse_args()

    try:
        if args.command == "init":
            init(args.target)
            return 0
        if args.command == "check":
            return check(args.target)
        if args.command == "update":
            return update(args.target)
    except (FileNotFoundError, BaselineError) as e:
        print(f"Error: {e}")
        return 2


if __name__ == "__main__":
    sys.exit(main())
